# Copy this file to .env and fill in real values.
# .env is git-ignored, so real keys never leave your machine.

# OpenAI: powers the agent (milestone 3) and the LLM judge (milestone 4)
OPENAI_API_KEY=

# Langfuse: tracing + evaluation (Project > Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
