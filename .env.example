# Copy this file to .env and fill in real values.
# .env is git-ignored, so real keys never leave your machine.

# OpenAI: powers the agent (milestone 3) and the LLM judge (milestone 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-sol

# Which agent to run (milestone 5 decision; see bookrec/factory.py)
AGENT_FRAMEWORK=langgraph
PROMPT_VERSION=v2

# Langfuse: tracing + evaluation (Project > Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Chat app (milestone 6)
PORT=8080
MAX_QUESTIONS_PER_CHAT=15
# Keeps app traces apart from experiments in Langfuse; the AWS deployment uses "production"
LANGFUSE_TRACING_ENVIRONMENT=development
