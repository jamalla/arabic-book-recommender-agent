# Copy to .env for a local run; .env is never committed or copied into the image.
# On AWS the same names come from the task definition: settings as environment
# variables, the three keys from Secrets Manager.

# Secrets
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Settings (the defaults are the agent that won the evaluation)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
OPENAI_MODEL=gpt-6-luna
AGENT_FRAMEWORK=langgraph
PROMPT_VERSION=v2
MAX_QUESTIONS_PER_CHAT=15
PORT=8080
